DB_URL=jdbc:postgresql://localhost:5432/microloan
DB_USERNAME=microloan
DB_PASSWORD=microloan
JWT_SECRET=replace-with-at-least-32-random-bytes
AI_CHAT_MODEL=none
AI_EMBEDDING_MODEL=none
AI_PROVIDER=BAILIAN
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_COMPLETIONS_PATH=/chat/completions
AI_CHAT_MODEL_NAME=qwen-plus
AI_EMBEDDINGS_PATH=/embeddings
AI_EMBEDDING_MODEL_NAME=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
AI_RISK_MODEL_ENABLED=false
AI_RISK_MODEL_CONFIDENCE_THRESHOLD=0.75
# 真实模型评测默认关闭，避免普通测试和 CI 消耗外部 API 额度。
REAL_MODEL_EVAL_ENABLED=false
REAL_EMBEDDING_EVAL_ENABLED=false
AI_MODEL_CALL_TIMEOUT=10s
KNOWLEDGE_VECTOR_ENABLED=false
KNOWLEDGE_VECTOR_INDEXING_ENABLED=false
KNOWLEDGE_ADMIN_API_KEY=
KNOWLEDGE_PDF_MAX_REQUEST_SIZE=11MB
KNOWLEDGE_CHUNK_MAX_CHARACTERS=800
KNOWLEDGE_MARKDOWN_MAX_BYTES=1048576
KNOWLEDGE_CLASSPATH_BOOTSTRAP_ENABLED=false
KNOWLEDGE_PDF_MAX_BYTES=10485760
KNOWLEDGE_PDF_MAX_PAGES=100

# 坐席工作台独立密钥，至少 32 字节；留空禁用。
SUPPORT_API_KEY=
